{
  "name": "vesper-planner",
  "version": "7.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:firebase": "firebase emulators:exec --project demo-vesper-sync --only auth,firestore \"node --test --test-reporter=spec tests/firebase/*.test.js\"",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "web-push": "3.6.7"
  },
  "devDependencies": { "@playwright/test": "1.64.1", "@firebase/rules-unit-testing": "6.0.0", "firebase": "13.1.0", "firebase-tools": "15.34.1" }
}
